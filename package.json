{
  "name": "perfekt",
  "version": "4.2.0",
  "description": "Release and version your packages with perfe(k)t ease!",
  "keywords": [
    "perfekt",
    "perfect",
    "release",
    "version",
    "changelog",
    "manager",
    "cli",
    "semver"
  ],
  "bugs": {
    "url": "https://github.com/lekterable/perfekt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekterable/perfekt.git"
  },
  "license": "MIT",
  "type": "module",
  "author": "Kornel Dubieniecki (https://kornel.me)",
  "bin": {
    "perfekt": "dist/cli.js"
  },
  "exports": {
    "./biome": "./biome.json",
    "./biome/arrow.grit": "./biome/arrow.grit",
    "./biome/should.grit": "./biome/should.grit",
    "./biome/loop.grit": "./biome/loop.grit",
    "./tsconfig": "./tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "biome.json",
    "biome",
    "tsconfig.base.json"
  ],
  "scripts": {
    "build": "tsdown",
    "ci": "pnpm run validate && pnpm run test:ci && pnpm run build",
    "dev": "tsdown --watch",
    "format": "biome check --write",
    "lint": "biome check",
    "prepare": "pnpm run build && husky",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run lint && pnpm run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "25.5.0",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "4.1.12",
    "commander": "14.0.3",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "perfekt": "link:.",
    "semver": "7.7.4",
    "tsdown": "0.21.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.5"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  }
}
