// Bans one-letter names: `person`, not `p`; `(left, right)`, not `(a, b)`; `index`, not `i`.
// Covers variables, parameters, destructured names and catch bindings. Type parameters (`T`) and `_` stay allowed.
language js

JsIdentifierBinding() as $name where {
  $name <: r"^[A-Za-z]$",
  register_diagnostic(span=$name, message="Spell the name out (`person`, not `p`; `(left, right)`, not `(a, b)`; `index`, not `i`).")
}
