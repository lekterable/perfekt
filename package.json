{
  "name": "perfekt",
  "version": "3.2.0",
  "description": "Release and version your packages with perfe(k)t ease!",
  "keywords": [
    "perfekt",
    "perfect",
    "release",
    "version",
    "changelog",
    "manager",
    "cli",
    "semver"
  ],
  "bugs": {
    "url": "https://github.com/lekterable/perfekt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekterable/perfekt.git"
  },
  "license": "MIT",
  "author": "Kornel Dubieniecki (https://kornel.me)",
  "bin": {
    "perfekt": "dist/cli.cjs"
  },
  "exports": {
    "./biome": "./biome.json",
    "./biome/arrow.grit": "./biome/arrow.grit",
    "./biome/should.grit": "./biome/should.grit",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "biome.json",
    "biome"
  ],
  "scripts": {
    "build": "tsdown",
    "ci": "pnpm run validate && pnpm run test:ci && pnpm run build",
    "dev": "tsdown --watch",
    "format": "biome check --write",
    "lint": "biome check",
    "prepare": "pnpm run build && husky",
    "test": "jest",
    "test:ci": "jest --collectCoverage --ci --runInBand",
    "test:coverage": "jest --collectCoverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run lint && pnpm run typecheck"
  },
  "dependencies": {
    "commander": "14.0.3",
    "cosmiconfig": "9.0.1",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/jest": "30.0.0",
    "@types/node": "25.5.0",
    "@types/semver": "7.7.1",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "jest-mock-process": "2.0.0",
    "lint-staged": "16.4.0",
    "perfekt": "link:.",
    "ts-jest": "29.4.6",
    "tsdown": "0.21.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.5"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  }
}
