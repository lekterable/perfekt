// Bans loops: use map/filter/reduce/flatMap/find, it.each for test tables, and
// reduce or recursion in one named helper for sequential async work.
language js

or {
  JsForStatement(),
  JsForOfStatement(),
  JsForInStatement(),
  JsWhileStatement(),
  JsDoWhileStatement(),
  `$_.forEach($...)`
} as $loop where {
  register_diagnostic(span=$loop, message="Write this declaratively (map, filter, reduce, flatMap, find, it.each) instead of a loop or forEach. Sequential async work goes in one named helper built on reduce or recursion.")
}
